okg:ALT_MET_EX14 a okg:SequenceVariantAlteration,
        owl:NamedIndividual ;
    rdfs:label "MET exon 14 skipping" ;
    okg:featureKey "alt.MET_EX14" ;
    okg:isDriver true ;
    okg:matchCdnaRegex "^c\\.(3028|3082)\\+[1-3]" ;
    okg:matchGene "MET" ;
    okg:matchProteinRegex "^exon14skip$" ;
    okg:requiresPathogenic false ;
    skos:prefLabel "MET exon 14 skipping" .

