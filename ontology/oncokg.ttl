@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix okg: <http://example.org/oncokg#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/oncokg> a owl:Ontology ;
    dcterms:created "2026-11-02"^^xsd:date ;
    dcterms:title "OncoKG - Molecular Biomarker Ontology for Lung, Breast and Prostate Cancer Identification" ;
    rdfs:comment "Research/educational knowledge model. Thresholds follow published guidelines where cited, but this is NOT a validated clinical decision tool." ;
    owl:versionInfo "1.0.0" .

okg:AGG_HRR_ANY a okg:CompositeBiomarker,
        owl:NamedIndividual ;
    rdfs:label "BRCA1/BRCA2/ATM/CDK12/PALB2 pathogenic variant" ;
    okg:featureKey "alt.HRR_ANY" ;
    skos:prefLabel "BRCA1/BRCA2/ATM/CDK12/PALB2 pathogenic variant" .

okg:AGG_NTRK_ANY a okg:CompositeBiomarker,
        owl:NamedIndividual ;
    rdfs:label "any NTRK1/2/3 fusion" ;
    okg:featureKey "alt.NTRK_ANY" ;
    skos:prefLabel "any NTRK1/2/3 fusion" .

okg:AGG_PTEN_ANY a okg:CompositeBiomarker,
        owl:NamedIndividual ;
    rdfs:label "PTEN pathogenic variant OR homozygous deletion" ;
    okg:featureKey "alt.PTEN_ANY" ;
    skos:prefLabel "PTEN pathogenic variant OR homozygous deletion" .

okg:AGG_RB1_ANY a okg:CompositeBiomarker,
        owl:NamedIndividual ;
    rdfs:label "RB1 pathogenic variant OR homozygous deletion" ;
    okg:featureKey "alt.RB1_ANY" ;
    skos:prefLabel "RB1 pathogenic variant OR homozygous deletion" .

okg:ALK_FISH_POS_PCT a okg:Parameter,
        owl:NamedIndividual ;
    rdfs:label "ALK_FISH_POS_PCT" ;
    okg:clinicalNote ">=15% cells with split signals" ;
    okg:hasGuideline okg:CAP_IASLC_AMP_2018 ;
    okg:paramValue 15.0 ;
    skos:prefLabel "ALK_FISH_POS_PCT" .

okg:ALT_ALK_FUSION a okg:GeneFusionAlteration,
        owl:NamedIndividual ;
    rdfs:label "ALK fusion (any 5' partner)" ;
    okg:featureKey "alt.ALK_FUSION" ;
    okg:fusion3Prime "ALK" ;
    okg:isDriver true ;
    okg:matchGene "ALK" ;
    skos:prefLabel "ALK fusion (any 5' partner)" .

okg:ALT_ATM_PATHOGENIC a okg:SequenceVariantAlteration,
        owl:NamedIndividual ;
    rdfs:label "ATM pathogenic / likely pathogenic variant" ;
    okg:featureKey "alt.ATM_PATHOGENIC" ;
    okg:isDriver false ;
    okg:matchGene "ATM" ;
    okg:requiresPathogenic true ;
    skos:prefLabel "ATM pathogenic / likely pathogenic variant" .

okg:ALT_AURKA_AMP a okg:CopyNumberAlteration,
        owl:NamedIndividual ;
    rdfs:label "AURKA amplification" ;
    okg:cnaType "amp" ;
    okg:featureKey "alt.AURKA_AMP" ;
    okg:isDriver true ;
    okg:matchGene "AURKA" ;
    skos:prefLabel "AURKA amplification" .

okg:ALT_BRAF_V600E a okg:SequenceVariantAlteration,
        owl:NamedIndividual ;
    rdfs:label "BRAF V600E" ;
    okg:featureKey "alt.BRAF_V600E" ;
    okg:isDriver true ;
    okg:matchGene "BRAF" ;
    okg:matchProteinRegex "^p\\.V600E$" ;
    okg:requiresPathogenic false ;
    skos:prefLabel "BRAF V600E" .

okg:ALT_BRCA1_PATHOGENIC a okg:SequenceVariantAlteration,
        owl:NamedIndividual ;
    rdfs:label "BRCA1 pathogenic / likely pathogenic variant" ;
    okg:featureKey "alt.BRCA1_PATHOGENIC" ;
    okg:isDriver false ;
    okg:matchGene "BRCA1" ;
    okg:requiresPathogenic true ;
    skos:prefLabel "BRCA1 pathogenic / likely pathogenic variant" .

okg:ALT_BRCA2_PATHOGENIC a okg:SequenceVariantAlteration,
        owl:NamedIndividual ;
    rdfs:label "BRCA2 pathogenic / likely pathogenic variant" ;
    okg:featureKey "alt.BRCA2_PATHOGENIC" ;
    okg:isDriver false ;
    okg:matchGene "BRCA2" ;
    okg:requiresPathogenic true ;
    skos:prefLabel "BRCA2 pathogenic / likely pathogenic variant" .

okg:ALT_CDK12_PATHOGENIC a okg:SequenceVariantAlteration,
        owl:NamedIndividual ;
    rdfs:label "CDK12 pathogenic / likely pathogenic variant" ;
    okg:featureKey "alt.CDK12_PATHOGENIC" ;
    okg:isDriver false ;
    okg:matchGene "CDK12" ;
    okg:requiresPathogenic true ;
    skos:prefLabel "CDK12 pathogenic / likely pathogenic variant" .

okg:ALT_EGFR_SENSITIZING a okg:SequenceVariantAlteration,
        owl:NamedIndividual ;
    rdfs:label "EGFR sensitizing mutation (L858R, exon19 del, G719X, L861Q, S768I)" ;
    okg:featureKey "alt.EGFR_SENSITIZING" ;
    okg:isDriver true ;
    okg:matchGene "EGFR" ;
    okg:matchProteinRegex "^p\\.(L858R|G719[ACSD]|L861Q|S768I)$",
        "^p\\.[A-Z](74[5-9]|75[0-9])_[A-Z](74[5-9]|75[0-9])(del|delins[A-Z]+)$" ;
    okg:requiresPathogenic false ;
    skos:prefLabel "EGFR sensitizing mutation (L858R, exon19 del, G719X, L861Q, S768I)" .

okg:ALT_EGFR_T790M a okg:SequenceVariantAlteration,
        owl:NamedIndividual ;
    rdfs:label "EGFR T790M" ;
    okg:featureKey "alt.EGFR_T790M" ;
    okg:isDriver false ;
    okg:matchGene "EGFR" ;
    okg:matchProteinRegex "^p\\.T790M$" ;
    okg:requiresPathogenic false ;
    skos:prefLabel "EGFR T790M" .

