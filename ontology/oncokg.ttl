    rdfs:label "somatic pathogenic/hotspot alteration (VAF >= floor)" ;
    okg:criterionValue "1" ;
    okg:featureKey "n_somatic_drivers" ;
    okg:operator "ge" ;
    okg:weight 2.0 ;
    skos:prefLabel "somatic pathogenic/hotspot alteration (VAF >= floor)" .

okg:ME_driver2 a okg:MalignancyEvidence,
        owl:NamedIndividual ;
    rdfs:label "two or more somatic alterations" ;
    okg:criterionValue "2" ;
    okg:featureKey "n_somatic_drivers" ;
    okg:operator "ge" ;
    okg:weight 1.0 ;
    skos:prefLabel "two or more somatic alterations" .

okg:ME_fga a okg:MalignancyEvidence,
        owl:NamedIndividual ;
    rdfs:label "fraction genome altered >= 10% (aneuploidy)" ;
    okg:criterionValue "0.1" ;
    okg:featureKey "fga" ;
    okg:operator "ge" ;
    okg:weight 2.0 ;
    skos:prefLabel "fraction genome altered >= 10% (aneuploidy)" .

okg:ME_fga_low a okg:MalignancyEvidence,
        owl:NamedIndividual ;
    rdfs:label "fraction genome altered >= 5%" ;
    okg:criterionValue "0.05" ;
    okg:featureKey "fga" ;
    okg:operator "ge" ;
    okg:weight 1.0 ;
    skos:prefLabel "fraction genome altered >= 5%" .

okg:ME_fusion a okg:MalignancyEvidence,
        owl:NamedIndividual ;
    rdfs:label "driver gene fusion" ;
    okg:criterionValue "1" ;
    okg:featureKey "n_driver_fusions" ;
    okg:operator "ge" ;
    okg:weight 3.0 ;
    skos:prefLabel "driver gene fusion" .

okg:ME_ki67_10 a okg:MalignancyEvidence,
        owl:NamedIndividual ;
    rdfs:label "Ki-67 >= 10%" ;
    okg:criterionValue "10" ;
    okg:featureKey "Ki67_pct" ;
