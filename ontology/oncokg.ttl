okg:EGFRMutantNSCLC a owl:Class ;
    rdfs:label "EGFR-mutant NSCLC" ;
    okg:approxPrevalence "~15% Western / ~40-50% East Asian LUAD" ;
    okg:hasGuideline okg:CAP_IASLC_AMP_2018 ;
    okg:isRareSubtype false ;
    okg:rarityTier "common" ;
    okg:therapyRelevance "EGFR TKI (osimertinib)" ;
    rdfs:subClassOf okg:NonSmallCellLungCancer .

okg:ERLowHER2NegativeBreastCancer a owl:Class ;
    rdfs:label "ER-low (1-10%), HER2-negative breast cancer" ;
    okg:approxPrevalence "~2-6%" ;
    okg:hasGuideline okg:ASCO_CAP_ER_PR_2020 ;
    okg:isRareSubtype true ;
    okg:rarityTier "rare" ;
    okg:therapyRelevance "biologically TNBC-like; often treated as TNBC" ;
    rdfs:subClassOf okg:BreastCancer .

